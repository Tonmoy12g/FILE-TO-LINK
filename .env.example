# Copy these into Render's Environment settings (never put real values in GitHub)

# Required: token from @BotFather
TELEGRAM_BOT_TOKEN=

# Required for admin features: your numeric Telegram chat ID (ask @userinfobot)
ADMIN_CHAT_ID=

# Optional: your username (without @) for the Support button
SUPPORT_USERNAME=

# Optional: upload provider - gofile (default, live-verified) | catbox | litterbox
UPLOAD_PROVIDER=gofile

# Optional: only needed if UPLOAD_PROVIDER=catbox and you have a Catbox account
CATBOX_USERHASH=

# Optional: max accepted file size in MB (Telegram Bot API hard limit is 20)
MAX_FILE_MB=20
